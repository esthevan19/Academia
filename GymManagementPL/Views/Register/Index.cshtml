@model GymManagementPL.Models.CadastroPublicoViewModel
@{
    Layout = null;
    ViewData["Title"] = "Criar conta | GymFlow";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Criar conta | GymFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root { color-scheme: light; }
        body { min-height: 100vh; background: #f5f5fc; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
        .cadastro-shell { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
        .cadastro-card { width: 100%; max-width: 440px; border: 1px solid #e4e3f1; border-radius: 22px; background: #fff; padding: clamp(24px, 5vw, 40px); box-shadow: 0 14px 45px rgba(7,0,147,.08); }
        .marca { color: #070093; font-size: 1.7rem; font-weight: 800; letter-spacing: -.05em; }
        h1 { color: #15152b; font-size: 1.8rem; font-weight: 750; margin: 26px 0 8px; }
        .subtitulo { color: #55556d; margin-bottom: 24px; }
        label { color: #232340; font-weight: 600; }
        .form-control { padding: 13px 14px; border-radius: 11px; border-color: #dbdbec; }
        .form-control:focus { border-color: #070093; box-shadow: 0 0 0 .15rem rgba(7,0,147,.13); }
        .btn-gymflow { width: 100%; border: 0; border-radius: 11px; background: #070093; color: white; padding: 13px; font-weight: 700; }
        .btn-gymflow:hover { background: #0d06b9; color: white; }
        .link-gymflow { color: #070093; font-weight: 700; }
        .aviso { color: #5a5a70; font-size: .86rem; }
    </style>
</head>
<body>
    <main class="cadastro-shell">
        <section class="cadastro-card" aria-labelledby="titulo-cadastro">
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none marca">GymFlow</a>
            <h1 id="titulo-cadastro">Criar sua conta</h1>
            <p class="subtitulo">Só precisa de e-mail e senha. Rápido e sem foto.</p>

            <form asp-controller="Register" asp-action="Index" method="post" autocomplete="on">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email"
                           placeholder="seuemail@exemplo.com" required maxlength="254" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Senha</label>
                    <input asp-for="Password" type="password" class="form-control"
                           autocomplete="new-password" minlength="8" required placeholder="Crie uma senha" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="aviso mt-1">Use 8 caracteres ou mais, incluindo número e letra maiúscula.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirmar senha</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           autocomplete="new-password" minlength="8" required placeholder="Repita sua senha" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-gymflow">Criar conta</button>
            </form>
            <p class="text-center mt-4 mb-1">Já tem uma conta?
                <a asp-controller="Account" asp-action="Login" class="link-gymflow">Entrar</a>
            </p>
            <p class="aviso mt-3 mb-0">Sua conta começa com acesso de aluno. Matrículas e fichas são vinculadas pela equipe da academia.</p>
        </section>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>