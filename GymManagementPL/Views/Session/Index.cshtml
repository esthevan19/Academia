@model IEnumerable<SessionViewModel>
@{
    ViewData["Title"] = "Aulas coletivas";
    var aulas = (Model ?? Enumerable.Empty<SessionViewModel>())
        .OrderBy(x => x.Status == "Upcoming" ? 0 : x.Status == "Ongoing" ? 1 : 2)
        .ThenBy(x => x.StartDate).ToList();
    var isStudent = User.IsInRole("Aluno");
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ||
                    User.IsInRole("Gerente") || User.IsInRole("Recepcionista") || User.IsInRole("Instrutor");
    var proximas = aulas.Count(x => x.Status == "Upcoming");
    var acontecendo = aulas.Count(x => x.Status == "Ongoing");
}
<style>
    .aulas-hero { border-radius:24px; padding:clamp(24px,4vw,42px); background:linear-gradient(120deg,#070093,#2e26bf); color:#fff; }
    .aulas-hero p { color:#e5e3ff; }
    .aulas-card { border:1px solid #e6e5f3; border-radius:19px; background:#fff; box-shadow:0 12px 34px rgba(7,0,147,.055); transition:transform .15s ease,box-shadow .15s ease; }
    .aulas-card:hover { transform:translateY(-2px); box-shadow:0 16px 38px rgba(7,0,147,.09); }
    .aulas-pill { display:inline-flex; align-items:center; gap:5px; background:#efedff; color:#070093; border-radius:999px; padding:6px 12px; font-weight:800; font-size:.8rem; }
    .aulas-meta { color:#62627a; font-size:.94rem; }
    .aulas-meta i { color:#070093; }
    .aulas-action { background:#070093; color:white; border-radius:11px; font-weight:700; padding:10px 14px; }
    .aulas-action:hover { background:#2119b8; color:#fff; }
    .aulas-stat { background:white; border:1px solid #e6e5f3; border-radius:16px; padding:19px 22px; }
    .aulas-stat strong { font-size:1.6rem; color:#070093; display:block; }
    .aulas-empty { background:white; border:1px dashed #cecee4; border-radius:18px; padding:45px 25px; text-align:center; }
</style>
<section class="container py-4 py-lg-5" style="max-width:1200px">
    <header class="aulas-hero mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="fw-bold text-uppercase small" style="letter-spacing:.12em">GymFlow · Academia</span>
                <h1 class="fw-bold mt-2 mb-2">Aulas coletivas</h1>
                <p class="mb-0">@(isStudent ? "Escolha sua próxima aula, consulte horários e garanta sua vaga." : "Organize horários, professores, vagas e atividades da academia.")</p>
            </div>
            @if (canManage)
            {
                <a asp-controller="Session" asp-action="Create" class="btn btn-light fw-bold rounded-3 px-4 py-3">
                    <i class="bi bi-plus-lg me-2"></i>Nova aula
                </a>
            }
            else if (isStudent)
            {
                <a asp-controller="StudentBooking" asp-action="Index" class="btn btn-light fw-bold rounded-3 px-4 py-3">
                    <i class="bi bi-calendar-check me-2"></i>Minhas reservas
                </a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-3" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger rounded-3" role="alert">@error</div>
    }

    <div class="row g-3 mb-4" aria-label="Resumo das aulas">
        <div class="col-sm-6 col-lg-4">
            <div class="aulas-stat"><strong>@proximas</strong><span class="text-muted">Próximas aulas</span></div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="aulas-stat"><strong>@acontecendo</strong><span class="text-muted">Acontecendo agora</span></div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="aulas-stat"><strong>@aulas.Count</strong><span class="text-muted">Aulas cadastradas</span></div>
        </div>
    </div>

    @if (aulas.Count == 0)
    {
        <div class="aulas-empty">
            <i class="bi bi-calendar-x fs-1" style="color:#7772ca"></i>
            <h2 class="h4 fw-bold mt-3">Nenhuma aula cadastrada</h2>
            <p class="text-muted mb-0">@(isStudent ? "As aulas aparecerão aqui quando a academia abrir novas turmas." : "Cadastre a primeira aula para organizar a agenda da academia.")</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var aula in aulas)
            {
                var status = aula.Status == "Ongoing" ? "Em andamento" : aula.Status == "Upcoming" ? "Agendada" : "Concluída";
                var vagas = Math.Max(0, aula.AvailableSlots);
                <div class="col-md-6 col-xl-4">
                    <article class="aulas-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span class="aulas-pill">@aula.CategoryName</span>
                            <span class="badge @(aula.Status == "Ongoing" ? "bg-success" : aula.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">@status</span>
                        </div>
                        <h2 class="h5 fw-bold mt-3 mb-2">@aula.Description</h2>
                        <p class="aulas-meta mb-2"><i class="bi bi-person-circle me-2"></i>@aula.TrainerName</p>
                        <p class="aulas-meta mb-2"><i class="bi bi-calendar3 me-2"></i>@aula.StartDate.ToString("dd/MM/yyyy")</p>
                        <p class="aulas-meta mb-2"><i class="bi bi-clock me-2"></i>@aula.TimeRangeDisplay</p>
                        <p class="aulas-meta mb-4"><i class="bi bi-people me-2"></i>@vagas de @aula.Capacity vagas disponíveis</p>
                        <div class="mt-auto d-grid gap-2">
                            @if (isStudent && aula.Status == "Upcoming")
                            {
                                <a asp-controller="StudentBooking" asp-action="Index" class="btn aulas-action">
                                    <i class="bi bi-calendar-check me-2"></i>Reservar ou consultar vaga
                                </a>
                            }
                            else if (canManage && aula.Status == "Ongoing")
                            {
                                <a asp-controller="Booking" asp-action="GetMembersForOngoingSession" asp-route-id="@aula.Id" class="btn aulas-action">
                                    <i class="bi bi-check2-square me-2"></i>Registrar presenças
                                </a>
                            }
                            else if (canManage && aula.Status == "Upcoming")
                            {
                                <a asp-controller="Booking" asp-action="GetMembersForUpcomingSession" asp-route-id="@aula.Id" class="btn aulas-action">
                                    <i class="bi bi-people me-2"></i>Ver reservas
                                </a>
                            }
                            <a asp-controller="Session" asp-action="Details" asp-route-id="@aula.Id" class="btn btn-outline-secondary rounded-3 fw-semibold">Ver detalhes</a>
                            @if (canManage && aula.Status == "Upcoming" && aula.AvailableSlots == aula.Capacity)
                            {
                                <div class="d-flex gap-2">
                                    <a asp-controller="Session" asp-action="Edit" asp-route-id="@aula.Id" class="btn btn-outline-primary rounded-3 flex-fill">Editar</a>
                                    <a asp-controller="Session" asp-action="Delete" asp-route-id="@aula.Id" class="btn btn-outline-danger rounded-3 flex-fill">Excluir</a>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    <p class="small text-muted mt-4 mb-0"><i class="bi bi-clock-history me-1"></i>Horários exibidos no fuso de Brasília (GMT−3).</p>
</section>
