@model CreateSessionViewModel

@{
    ViewData["Title"] = "Criar Aula Coletiva";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Criar Nova Aula Coletiva</h3>
        <p class="text-muted">Agende uma nova aula coletiva</p>
    </header>

    @Html.ValidationMessage("DataMissed", new { @class = "text-danger" })

    <form asp-action="Create" method="post">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <!-- Informações da Aula -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Informações da Aula</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">
                                    Tipo de aula <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select">
                                    <option value="">Selecione o tipo de aula</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TrainerId" class="form-label fw-semibold">
                                    Professor responsável <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TrainerId" asp-items="@ViewBag.Trainers" class="form-select">
                                    <option value="">Selecione o professor</option>
                                </select>
                                <span asp-validation-for="TrainerId" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Descrição <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"
                                          placeholder="Descreva o conteúdo e os objetivos da aula..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Capacity" class="form-label fw-semibold">
                                    Capacidade <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Capacity" type="number" class="form-control" placeholder="25" min="1" max="25" />
                                <small class="text-muted">Número máximo de participantes</small>
                                <span asp-validation-for="Capacity" class="text-danger d-block"></span>
                            </div>
                        </div>

                        <!-- Data e Horário -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Data e Horário</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    Data e Horário de Início <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">
                                    Data e Horário de Término <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>Criar Aula
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startInput = document.querySelector('input[name="StartDate"]');
            const endInput = document.querySelector('input[name="EndDate"]');
            if (!startInput || !endInput) return;

            function horarioLocal(data) {
                return new Date(data.getTime() - data.getTimezoneOffset() * 60000)
                    .toISOString().slice(0, 16);
            }

            function adicionarMinutos(data, minutos) {
                return new Date(data.getTime() + minutos * 60000);
            }

            // O horário inicial sugerido deve ser futuro, não o minuto atual.
            const agora = new Date();
            if (!startInput.value || startInput.value.startsWith("0001")) {
                startInput.value = horarioLocal(adicionarMinutos(agora, 10));
            }
            if (!endInput.value || endInput.value.startsWith("0001")) {
                endInput.value = horarioLocal(adicionarMinutos(new Date(startInput.value), 60));
            }

            function atualizarLimites() {
                const minimoInicio = horarioLocal(adicionarMinutos(new Date(), 1));
                startInput.min = minimoInicio;
                const inicioEscolhido = startInput.value && startInput.value > minimoInicio
                    ? startInput.value : minimoInicio;
                endInput.min = horarioLocal(adicionarMinutos(new Date(inicioEscolhido), 1));
            }

            atualizarLimites();
            startInput.addEventListener("change", function () {
                atualizarLimites();
                if (endInput.value && endInput.value < endInput.min) {
                    endInput.value = "";
                }
            });
            startInput.addEventListener("focus", atualizarLimites);
            endInput.addEventListener("focus", atualizarLimites);
            const formulario = startInput.closest("form");
            if (formulario) formulario.addEventListener("submit", atualizarLimites);
        });
    </script>

}