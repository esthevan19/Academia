@using GymManagementBLL.ViewModels.AccountViewModels
@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar | GymFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/AuthStyle.css" />
    <link rel="stylesheet" href="~/css/login.css" />


</head>

<body>
    <div class="login-container">
        <!-- Lado Esquerdo - Formulário de Login -->
        <div class="login-form-section">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h1 class="brand-name">GymFlow</h1>
                <p class="brand-subtitle">Sistema de Gestão de Academias</p>
            </div>

            <h2 class="login-title">Acesse o GymFlow</h2>
            <p class="login-subtitle">Bem-vindo de volta! Faça login na sua conta</p>

            <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
                @Html.ValidationMessage("InvalidLogin", new { @class = "text-danger" })

                <div class="form-floating">
                    <input asp-for="Email" class="form-control" id="floatingEmail" placeholder="admin@exemplo.com"
                           autocomplete="username" />
                    <label for="floatingEmail">
                        <i class="bi bi-envelope me-2"></i>E-mail
                    </label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Password" class="form-control" id="floatingPassword" placeholder="Senha"
                           autocomplete="current-password" />
                    <label for="floatingPassword">
                        <i class="bi bi-lock-fill me-2"></i>Senha
                    </label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">
                            Lembrar de mim por 24 horas
                        </label>
                    </div>

                    <button type="submit" class="btn btn-login" id="loginBtn">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar no Painel
                    </button>

                    <div class="text-center mt-3">
                        <span class="text-muted">Ainda não é membro?</span>
                        <a asp-controller="Register" asp-action="Index" class="fw-semibold" style="color:#070093;">Cadastre-se aqui</a>
                    </div>
                </form>
            </div>

            <!-- Lado Direito - Informações da Academia -->
            <div class="gym-info-section">
                <div class="gym-content">
                    <div class="gym-icon">
                        💪
                    </div>
                    <h2 class="gym-title">
                        Sua academia <span style="color: #ffd700;">organizada</span><br>
                        em um só lugar
                    </h2>
                    <p class="gym-description">
                        Gerencie alunos, instrutores, planos e agendamentos<br>
                        com segurança e praticidade, no site e no aplicativo.
                    </p>

                    <div class="stats-container"><p class="text-white">Gestão de academia com informações centralizadas.</p></div>
                </div>
            </div>
        </div>


        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <partial name="_ValidationScriptsPartial" />

        <script>
                $(function() {
                    $('#floatingEmail').focus();

                    $('#loginForm').on('submit', function() {
                        if ($(this).valid()) {
                            const btn = document.getElementById('loginBtn');
                            btn.classList.add('loading');
                            btn.disabled = true;
                        }
                    });
                });
        </script>
    </body>

</html>
