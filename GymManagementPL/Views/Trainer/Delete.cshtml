@{
    ViewData["Title"] = "Excluir professor";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 shadow text-center">

                <p class="fs-3 text-primary-color mb-4">Tem certeza de que deseja excluir este professor?</p>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>Atenção!</strong> Esta ação não pode ser desfeita. Os dados do professor serão excluídos permanentemente.
                </div>

                <form asp-action="DeleteConfirmed" method="post" class="mt-4">
                    <input type="hidden" name="id" value="@ViewBag.TrainerId" readonly />
                    <div class="buttons d-flex justify-content-between gap-3">
                        <a asp-controller="Trainer" asp-action="Index" class="btn-outline flex-fill">Não</a>
                        <button type="submit" class="btn-fill flex-fill">Sim, excluir</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>