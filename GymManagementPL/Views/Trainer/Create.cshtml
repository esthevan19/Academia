@model CreateTrainerViewModel

@{
    ViewData["Title"] = "Cadastrar Professor";
}

<header class="mb-4">
    <h3 class="text-primary-color">Cadastrar Professor</h3>
</header>

@Html.ValidationMessage("DataMissed", new { @class = "text-danger" })

<form method="post" asp-action="CreateTrainer">

    <!-- Informações do Treinador -->
    <div class="section-header mb-3">
        <h5 class="text-primary fw-bold">Informações Pessoais</h5>
        <hr class="mt-2">
    </div>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" type="text" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>

        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" type="tel" inputmode="numeric" maxlength="11" placeholder="Ex.: 51987654321" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>

        </div>

        <div class="col-12 col-md-6">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                <option value="">-- Selecione o Gênero --</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

    </div>
    <div class="section-header mb-3 mt-4">
        <h5 class="text-primary fw-bold">Informações de Endereço</h5>
        <hr class="mt-2">
    </div>
    <div class="row g-3">

        <div class="col-12 col-md-6">
            <label asp-for="BuildingNumber" class="form-label"></label>
            <input asp-for="BuildingNumber" type="number" min="1" max="999999" class="form-control" />
            <span asp-validation-for="BuildingNumber" class="text-danger"></span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Street" class="form-label"></label>
            <input asp-for="Street" type="text" class="form-control" />
            <span asp-validation-for="Street" class="text-danger"></span>

        </div>
        <div class="col-12 col-md-6">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" type="text" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>

        </div>
    </div>
    <!-- Informações Profissionais -->
    <div class="section-header mb-3">
        <h5 class="text-primary fw-bold">Informações Profissionais</h5>
        <hr class="mt-2">
    </div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-semibold">
                Especializações <span class="text-danger">*</span>
            </label>

            @foreach (var opcao in GymManagementPL.Models.GymSpecialtiesPtBr.RegistrationOptions)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Specialties"
                           value="@opcao.Value" id="especializacao-@opcao.Value" />
                    <label class="form-check-label" for="especializacao-@opcao.Value">@opcao.Label</label>
                </div>
            }
            <span asp-validation-for="Specialties" class="text-danger"></span>
        </div>
    </div>

    <footer class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-fill">Cadastrar professor</button>
    </footer>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
