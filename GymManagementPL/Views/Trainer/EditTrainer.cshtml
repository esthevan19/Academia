@model TrainerToUpdateViewModel
@{
    ViewData["Title"] = "Editar Professor";
    var trainerId = ViewContext.RouteData.Values["id"];
}
<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Editar Professor</h3>
        <p class="text-muted">Atualize os dados do professor</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="mb-4 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Editando o perfil de</small>
                        <h4 class="mb-0 text-black">@Model.Name</h4>
                    </div>
                    <form asp-action="EditTrainer" asp-route-id="@trainerId" method="post">
                        @Html.AntiForgeryToken()
                        <input hidden asp-for="Name" />
                        <!-- Dados pessoais -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Dados pessoais</h5>
                            <hr class="mt-2">
                        </div>
                        <div class="row g-3 mb-4">


                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" type="tel" inputmode="numeric" maxlength="11" placeholder="Ex.: 51987654321" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BuildingNumber" class="form-label"></label>
                                <input asp-for="BuildingNumber" type="number" min="1" max="999999" class="form-control" />
                                <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Street" class="form-label"></label>
                                <input asp-for="Street" type="text" class="form-control" />
                                <span asp-validation-for="Street" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" type="text" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Informações profissionais -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Informações profissionais</h5>
                            <hr class="mt-2">
                        </div>
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Especialização <span class="text-danger">*</span>
                                </label>

                                @foreach (var opcao in GymManagementPL.Models.GymSpecialtiesPtBr.RegistrationOptions)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Specialties"
                           value="@opcao.Value" id="especializacao-@opcao.Value" />
                    <label class="form-check-label" for="especializacao-@opcao.Value">@opcao.Label</label>
                </div>
            }
            @if (!GymManagementPL.Models.GymSpecialtiesPtBr.IsRegistrationOption(Model.Specialties))
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Specialties" value="@Model.Specialties" id="especializacao-anterior" />
                    <label class="form-check-label" for="especializacao-anterior">
                        @GymManagementPL.Models.GymSpecialtiesPtBr.Display(Model.Specialties.ToString()) (cadastro anterior)
                    </label>
                </div>
            }
            <span asp-validation-for="Specialties" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>Salvar alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
