@model CreateMemberViewModel
@{
    ViewData["Title"] = "Cadastrar aluno";
}
<section class="py-4" style="max-width: 1050px; margin: auto">
    <div class="d-flex justify-content-between flex-wrap align-items-start gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold" style="color:#070093">Cadastrar aluno</h1>
            <p class="text-muted">Preencha os dados de matrícula. A foto não é obrigatória.</p>
        </div>
        <a asp-controller="Member" asp-action="Index" class="btn btn-outline-secondary">Voltar aos alunos</a>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    @Html.ValidationMessage("DataMissed", new { @class = "text-danger" })

    <form asp-controller="Member" asp-action="CreateMember" method="post" class="card border-0 shadow-sm rounded-4 p-4">
        @Html.AntiForgeryToken()

        <h2 class="h5 fw-bold mb-3" style="color:#070093">Dados pessoais</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Nome completo</label>
                <input asp-for="Name" class="form-control" placeholder="Nome e sobrenome" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">E-mail</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="email@exemplo.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">Celular com DDD</label>
                <input asp-for="Phone" class="form-control" type="tel" inputmode="numeric" maxlength="11" placeholder="51987654321" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DateOfBirth" class="form-label">Data de nascimento</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Gender" class="form-label">Gênero</label>
                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                    <option value="">Selecione</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger small"></span>
            </div>
        </div>

        <hr class="my-4" />
        <h2 class="h5 fw-bold mb-3" style="color:#070093">Endereço</h2>
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="Street" class="form-label">Rua</label>
                <input asp-for="Street" class="form-control" placeholder="Ex.: Rua São José" />
                <span asp-validation-for="Street" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="City" class="form-label">Cidade</label>
                <input asp-for="City" class="form-control" placeholder="Ex.: Parobé" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="BuildingNumber" class="form-label">Número</label>
                <input asp-for="BuildingNumber" class="form-control" type="number" min="1" max="999999" />
                <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
            </div>
        </div>

        <hr class="my-4" />
        <h2 class="h5 fw-bold mb-2" style="color:#070093">Ficha de saúde</h2>
        <p class="small text-muted">Preenchida pela equipe da academia. Dados de saúde não são solicitados na criação de conta de acesso.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="HealthRecordViewModel.Height" class="form-label">Altura (m)</label>
                <input asp-for="HealthRecordViewModel.Height" type="text" inputmode="decimal" class="form-control" placeholder="Ex.: 1,75" />
                <span asp-validation-for="HealthRecordViewModel.Height" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="HealthRecordViewModel.Weight" class="form-label">Peso (kg)</label>
                <input asp-for="HealthRecordViewModel.Weight" type="text" inputmode="decimal" class="form-control" placeholder="Ex.: 70,5" />
                <span asp-validation-for="HealthRecordViewModel.Weight" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="HealthRecordViewModel.BloodType" class="form-label">Tipo sanguíneo</label>
                <select asp-for="HealthRecordViewModel.BloodType" class="form-select">
                    <option value="">Selecione</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                </select>
                <span asp-validation-for="HealthRecordViewModel.BloodType" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="HealthRecordViewModel.Note" class="form-label">Observações de saúde (opcional)</label>
                <textarea asp-for="HealthRecordViewModel.Note" class="form-control" rows="2" placeholder="Informações relevantes para o acompanhamento"></textarea>
                <span asp-validation-for="HealthRecordViewModel.Note" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
            <a asp-controller="Member" asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4" style="background:#070093;border-color:#070093">Salvar aluno</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}