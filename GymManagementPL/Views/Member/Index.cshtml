@model IEnumerable<MemberViewModel>
@{
    ViewData["Title"] = "Alunos";
    var alunos = Model?.ToList() ?? new List<MemberViewModel>();
    var podeExcluir = User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente");
}
<style>
    .alunos-hero { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; border-radius:24px; padding:clamp(24px,4vw,42px); background:linear-gradient(115deg,#070093,#2921b9); color:#fff; }
    .alunos-hero p { color:#e3e1ff; }
    .alunos-busca { background:#fff; border:1px solid #e8e7f4; border-radius:17px; padding:19px 21px; }
    .alunos-busca .form-control { border:1px solid #d7d6e8; border-radius:12px; min-height:47px; }
    .alunos-busca .form-control:focus { border-color:#070093; box-shadow:0 0 0 .2rem rgba(7,0,147,.1); }
    .aluno-card { display:flex; flex-direction:column; height:100%; border:1px solid #e7e6f2; border-radius:19px; background:#fff; padding:22px; box-shadow:0 10px 32px rgba(7,0,147,.045); transition:transform .15s ease,box-shadow .15s ease; }
    .aluno-card:hover { transform:translateY(-2px); box-shadow:0 15px 38px rgba(7,0,147,.08); }
    .aluno-avatar { display:grid; place-items:center; flex-shrink:0; width:50px; height:50px; border-radius:15px; background:#eeedff; color:#070093; font-size:1.5rem; }
    .aluno-card h2 { font-size:1.1rem; font-weight:800; color:#24243b; overflow-wrap:anywhere; }
    .aluno-meta { display:flex; gap:10px; align-items:flex-start; margin-bottom:12px; color:#55556e; font-size:.89rem; overflow-wrap:anywhere; }
    .aluno-meta i { color:#070093; font-size:1rem; flex-shrink:0; }
    .aluno-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; margin-top:auto; padding-top:14px; border-top:1px solid #efedf8; }
    .aluno-actions .btn { border-radius:10px; padding:10px 9px; font-weight:700; font-size:.84rem; }
    .aluno-primary { background:#070093; border-color:#070093; color:#fff; }
    .aluno-primary:hover { background:#2118b9; border-color:#2118b9; color:#fff; }
    .aluno-secondary { border:1px solid #d9d7ef; color:#070093; background:#fff; }
    .aluno-secondary:hover { background:#f0efff; color:#070093; }
    .aluno-empty { text-align:center; background:#fff; border:1px dashed #d2d0e7; border-radius:19px; padding:48px 25px; }
    @@media(max-width:575px) { .aluno-card { padding:19px; } .alunos-hero { padding:25px; } }
</style>
<section class="container py-4 py-md-5" style="max-width:1200px">
    <header class="alunos-hero mb-4">
        <div>
            <span class="fw-bold small text-uppercase" style="letter-spacing:.12em">GymFlow · Gestão de alunos</span>
            <h1 class="h2 fw-bold mt-2 mb-2">Alunos da academia</h1>
            <p class="mb-0">Cadastros, contatos e informações organizados em um só lugar.</p>
        </div>
        <a asp-controller="Member" asp-action="Create" class="btn btn-light fw-bold rounded-3 px-4 py-3">
            <i class="bi bi-person-plus me-2"></i>Cadastrar aluno
        </a>
    </header>

    @if (TempData["SuccessMessage"] is string sucesso)
    {
        <div class="alert alert-success rounded-3" role="status"><i class="bi bi-check-circle me-2"></i>@sucesso</div>
    }
    @if (TempData["ErrorMessage"] is string erro)
    {
        <div class="alert alert-danger rounded-3" role="alert"><i class="bi bi-exclamation-circle me-2"></i>@erro</div>
    }

    @if (alunos.Count == 0)
    {
        <div class="aluno-empty">
            <i class="bi bi-people fs-1" style="color:#7772c6" aria-hidden="true"></i>
            <h2 class="h5 fw-bold mt-3">Nenhum aluno cadastrado</h2>
            <p class="text-muted mb-3">Comece cadastrando o primeiro aluno da academia.</p>
            <a asp-controller="Member" asp-action="Create" class="btn aluno-primary fw-bold rounded-3 px-4 py-2">Cadastrar primeiro aluno</a>
        </div>
    }
    else
    {
        <div class="alunos-busca d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
            <div class="flex-grow-1" style="min-width:min(100%,280px)">
                <label for="buscaAlunos" class="form-label fw-bold mb-2" style="color:#24243b">
                    <i class="bi bi-search me-2" style="color:#070093"></i>Buscar aluno
                </label>
                <input id="buscaAlunos" type="search" class="form-control" autocomplete="off"
                       placeholder="Pesquise por nome, e-mail ou telefone" />
            </div>
            <span class="text-muted small fw-semibold" id="contagemAlunos" aria-live="polite">
                @alunos.Count @(alunos.Count == 1 ? "aluno encontrado" : "alunos encontrados")
            </span>
        </div>
        <div class="row g-3" id="listaAlunos">
            @foreach (var aluno in alunos)
            {
                var busca = $"{aluno.Name} {aluno.Email} {aluno.Phone}";
                var genero = aluno.Gender == "Male" ? "Masculino" :
                             aluno.Gender == "Female" ? "Feminino" :
                             string.IsNullOrWhiteSpace(aluno.Gender) ? "Não informado" : aluno.Gender;
                <div class="col-12 col-md-6 col-xl-4 aluno-item" data-search="@busca">
                    <article class="aluno-card">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <span class="aluno-avatar"><i class="bi bi-person" aria-hidden="true"></i></span>
                            <div class="min-width-0">
                                <h2 class="mb-1">@aluno.Name</h2>
                                <span class="small text-muted">Cadastro #@aluno.Id</span>
                            </div>
                        </div>
                        <div class="aluno-meta"><i class="bi bi-envelope"></i><span>@aluno.Email</span></div>
                        <div class="aluno-meta"><i class="bi bi-telephone"></i><span>@aluno.Phone</span></div>
                        <div class="aluno-meta mb-4"><i class="bi bi-person-badge"></i><span>@genero</span></div>
                        <div class="aluno-actions">
                            <a asp-controller="Member" asp-action="MemberDetails" asp-route-id="@aluno.Id"
                               class="btn aluno-primary"><i class="bi bi-eye me-1"></i>Ver cadastro</a>
                            <a asp-controller="Member" asp-action="EditMember" asp-route-id="@aluno.Id"
                               class="btn aluno-secondary"><i class="bi bi-pencil me-1"></i>Editar</a>
                            <a asp-controller="Member" asp-action="HealthRecordDetails" asp-route-id="@aluno.Id"
                               class="btn aluno-secondary"><i class="bi bi-clipboard2-pulse me-1"></i>Ficha de saúde</a>
                            @if (podeExcluir)
                            {
                                <a asp-controller="Member" asp-action="Delete" asp-route-id="@aluno.Id"
                                   class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Excluir</a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
        <div id="semResultados" class="aluno-empty mt-3" hidden>
            <i class="bi bi-search fs-1" style="color:#7772c6" aria-hidden="true"></i>
            <h2 class="h5 fw-bold mt-3">Nenhum aluno encontrado</h2>
            <p class="text-muted mb-0">Tente pesquisar por outro nome, e-mail ou telefone.</p>
        </div>
    }
</section>
@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const input = document.getElementById("buscaAlunos");
            if (!input) return;
            const cards = Array.from(document.querySelectorAll(".aluno-item"));
            const counter = document.getElementById("contagemAlunos");
            const empty = document.getElementById("semResultados");
            const normalize = (value) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("pt-BR").trim();
            input.addEventListener("input", () => {
                const query = normalize(input.value);
                let count = 0;
                for (const card of cards) {
                    const matches = normalize(card.dataset.search || "").includes(query);
                    card.hidden = !matches;
                    if (matches) count++;
                }
                if (counter) counter.textContent = count + (count === 1 ? " aluno encontrado" : " alunos encontrados");
                if (empty) empty.hidden = count !== 0;
            });
        });
    </script>
}
