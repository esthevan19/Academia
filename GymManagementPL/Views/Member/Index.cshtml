@model IEnumerable<MemberViewModel>

@{
    ViewData["Title"] = "Alunos";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}



<div class="container">
    <header class="d-flex justify-content-end mt-5 mb-4 align-items-center">
        <a asp-controller="Member" asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-3 py-3">
            + Cadastrar aluno
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive " style="overflow: visible;">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th><span>Foto</span></th>
                        <th><span>Nome</span></th>
                        <th><span>E-mail</span></th>
                        <th><span>Gênero</span></th>
                        <th><span>Telefone</span></th>
                        <th><span>Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>
                                <span class="avatar">
                                    @if (string.IsNullOrEmpty(member.Photo))
                                    {
                                        <img src="~/images/User.jpg" alt="Foto padrão" class="rounded-circle"
                                             style="width: 40px; height: 40px;" />
                                    }
                                    else
                                    {
                                        <img src="~/images/members/@member.Photo" alt="@member.Name" class="rounded-circle"
                                             style="width: 40px; height: 40px;" />
                                    }
                                </span>
                            </td>
                            <td><span>@member.Name</span></td>
                            <td><span>@member.Email</span></td>
                            <td><span>@(member.Gender == "Male" ? "Masculino" : member.Gender == "Female" ? "Feminino" : member.Gender)</span></td>
                            <td><span>@member.Phone</span></td>
                            <td class="action position-relative">
                                <div class="dropdown">
                                    <button class="btn btn-link p-0 border-0" type="button"
                                            id="dropdownMenuButton-@member.Id" data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <img src="~/images/action dots.jpg" alt="Ações" />
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-start"
                                        aria-labelledby="dropdownMenuButton-@member.Id">
                                        <li>
                                            <a asp-controller="Member" asp-action="MemberDetails" asp-route-id="@member.Id"
                                               class="dropdown-item d-flex align-items-center gap-3">
                                                <img src="~/images/info 1.jpg" alt="Informações"
                                                     style="width: 20px; height: 20px;" />
                                                <span>Ver dados do aluno</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Member" asp-action="HealthRecordDetails" asp-route-id="@member.Id"
                                               class="dropdown-item d-flex align-items-center gap-3">
                                                <img src="~/images/info 1.jpg" alt="Informações"
                                                     style="width: 20px; height: 20px;" />
                                                <span>Ver ficha de saúde</span>
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a asp-controller="Member" asp-action="EditMember" asp-route-id="@member.Id"
                                               class="dropdown-item d-flex align-items-center gap-3">
                                                <img src="~/images/edit.jpg" alt="Editar"
                                                     style="width: 20px; height: 20px;" />
                                                <span>Editar aluno</span>
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a asp-controller="Member" asp-action="Delete" asp-route-id="@member.Id"
                                               class="dropdown-item d-flex align-items-center gap-3 text-danger">
                                                <img src="~/images/x-circle 1.jpg" alt="Excluir"
                                                     style="width: 20px; height: 20px;" />
                                                <span>Excluir</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>

                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Nenhum aluno cadastrado</h4>
            <p class="text-muted">Cadastre o primeiro aluno para começar</p>
        </div>
    }

</div>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const alertBox = document.getElementById("Alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";
                    setTimeout(() => alertBox.remove(), 500);
                }, 1500);
            }
        });
    </script>

}