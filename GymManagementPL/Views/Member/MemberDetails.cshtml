@model MemberViewModel
@{
    ViewData["Title"] = "Dados do aluno";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-details border-0 p-2 shadow">
                <div class="text-center mt-3">
                    <img src="~/images/members/@Model.Photo" alt="@Model.Name" class="rounded-circle"
                         style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />
                </div>
                <div class="card-body text-center">
                    <h2 class="mb-1 text-primary-color">@Model.Name</h2>
                    <h4 class="mb-2 pb-1 border-bottom d-block">@(Model.PlanName ?? "Sem plano ativo")</h4>
                    <div class="mt-4 text-start">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">E-mail</small>
                                    <strong>@Model.Email</strong>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">Telefone</small>
                                    <strong>@Model.Phone</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">Gênero</small>
                                    <strong>@(Model.Gender == "Male" ? "Masculino" : Model.Gender == "Female" ? "Feminino" : Model.Gender)</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">Nascimento</small>
                                    <strong>@Model.DateOfBirth</strong>
                                </div>
                            </div>


                            @if (Model.PlanName is not null)
                            {
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block mb-1">Início da matrícula</small>
                                        <strong>@Model.MembershipStartDate</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block mb-1">Fim da matrícula</small>
                                        <strong>@Model.MembershipEndDate</strong>
                                    </div>
                                </div>
                            }

                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">Endereço</small>
                                    <strong>@(Model.Address ?? "Endereço não informado")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 px-3 pb-3">
                    <a asp-controller="Member" asp-action="Index" class="btn btn-fill flex-fill">Voltar aos alunos</a>
                </div>
            </div>
        </div>
    </div>
</div>
