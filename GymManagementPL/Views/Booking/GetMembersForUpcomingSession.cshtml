@model IEnumerable<MemberForSessionViewModel>
@{
    ViewData["Title"] = "Reservas da aula";
    var sessionId = ViewContext.RouteData.Values["id"]?.ToString();
    var podeGerenciar = User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ||
                        User.IsInRole("Gerente") || User.IsInRole("Recepcionista");
}
<style>
    .gym-table-card { border:1px solid #e6e5f2; border-radius:18px; background:#fff; overflow:hidden; box-shadow:0 12px 38px rgba(7,0,147,.06); }
    .gym-table-card .table th { background:#f1f0ff; color:#070093; font-size:.82rem; letter-spacing:.03em; font-weight:800; padding:16px; }
    .gym-table-card .table td { padding:16px; vertical-align:middle; }
    .gym-purple { background:#070093; color:white; border-radius:11px; font-weight:700; padding:12px 18px; }
    .gym-purple:hover { background:#2017ba; color:#fff; }
</style>
<section class="container py-4 py-md-5" style="max-width:1060px">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <p class="fw-bold small text-uppercase mb-1" style="color:#070093">GymFlow · Agenda</p>
            <h1 class="h2 fw-bold mb-1">Reservas da aula</h1>
            <p class="text-muted mb-0">Consulte os alunos inscritos e acompanhe a ocupação.</p>
        </div>
        @if (podeGerenciar)
        {
            <a asp-controller="Booking" asp-action="Create" asp-route-id="@sessionId" class="btn gym-purple">
                <i class="bi bi-plus-circle me-1"></i> Adicionar reserva
            </a>
        }
    </div>
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-3" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger rounded-3" role="alert">@error</div>
    }
    <div class="gym-table-card mb-4">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr><th>Aluno</th><th>Data da reserva</th><th class="text-end">Situação</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var reserva in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@reserva.MemberName</td>
                            <td class="text-muted">@reserva.BookingDate</td>
                            <td class="text-end">
                                @if (podeGerenciar)
                                {
                                    <form asp-controller="Booking" asp-action="Cancel" method="post"
                                          onsubmit="return confirm('Cancelar a reserva deste aluno?');" class="d-inline">
                                        <input type="hidden" name="MemberId" value="@reserva.MemberId" />
                                        <input type="hidden" name="SessionId" value="@reserva.SessionId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 fw-semibold">
                                            <i class="bi bi-x-circle me-1"></i>Cancelar reserva
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">Confirmada</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center p-5">
                <i class="bi bi-people display-5" style="color:#7775c6"></i>
                <h2 class="h5 fw-bold mt-3">Nenhuma reserva por enquanto</h2>
                <p class="text-muted mb-0">Os participantes aparecerão quando uma vaga for reservada.</p>
            </div>
        }
    </div>
    <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-secondary rounded-3">
        <i class="bi bi-arrow-left me-1"></i> Voltar à agenda
    </a>
</section>