@model IEnumerable<SessionViewModel>

@{
    ViewData["Title"] = "Agendamentos";
}

<div class="container">

    @if (Model is not null && Model.Any())
    {
        <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
            <div>
                <h2 class="text-primary-color mb-0">Aulas coletivas</h2>
                <p class="text-muted">Aulas com horários disponíveis para reservas</p>
            </div>
        </header>
        <div class="row g-4 ">
            @foreach (var session in Model.Where(X => X.Status == "Upcoming"))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <div class="card-header text-white py-3 bg-primary ">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">@(session.Status == "Upcoming" ? "Agendada" : session.Status == "Ongoing" ? "Em andamento" : session.Status)</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="session-info mb-3">
                                <div class="info-item mb-2">
                                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                                    <strong>Professor:</strong> @session.TrainerName
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                                    <strong>Data:</strong> @session.DateDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-clock text-primary-color me-2"></i>
                                    <strong>Horário:</strong> @session.TimeRangeDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-hourglass-split text-primary-color me-2"></i>
                                    <strong>Duração:</strong> @session.Duration
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-people text-primary-color me-2"></i>
                                    <strong>Capacidade:</strong> @session.AvailableSlots/@session.Capacity vagas
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-action="GetMembersForUpcomingSession" asp-route-id="@session.Id" class="btn btn-outline btn-sm">
                                    <i class="bi bi-eye me-1"></i> Ver Membros
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
            <div>
                <h2 class="text-primary-color mb-0">Aulas coletivas</h2>
                <p class="text-muted">Aulas em andamento para registrar presença</p>
            </div>
        </header>
        <div class="row g-4 ">
            @foreach (var session in Model.Where(X => X.Status == "Ongoing"))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <div class="card-header text-white py-3 bg-success ">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="session-info mb-3">
                                <div class="info-item mb-2">
                                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                                    <strong>Professor:</strong> @session.TrainerName
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                                    <strong>Data:</strong> @session.DateDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-clock text-primary-color me-2"></i>
                                    <strong>Horário:</strong> @session.TimeRangeDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-hourglass-split text-primary-color me-2"></i>
                                    <strong>Duração:</strong> @session.Duration
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-people text-primary-color me-2"></i>
                                    <strong>Capacidade:</strong> @session.AvailableSlots/@session.Capacity vagas
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-action="GetMembersForOngoingSession" asp-route-id="@session.Id" class="btn btn-outline btn-sm">
                                    <i class="bi bi-eye me-1"></i> Ver Membros
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Nenhuma aula disponível</h4>
            <p class="text-muted">Cadastre uma aula para organizar os agendamentos</p>
        </div>
    }
</div>
