@model CreateBookingViewModel
@{
    ViewData["Title"] = "Nova reserva";
}
<section class="container py-5" style="max-width:760px">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <span class="small fw-bold text-uppercase" style="color:#070093">GymFlow · Agenda</span>
        <h1 class="h2 fw-bold mt-2 mb-2">Reservar vaga</h1>
        <p class="text-muted mb-4">
            Aula: <strong>@ViewBag.SessionName</strong>.
            Selecione o aluno que já possui matrícula ativa.
        </p>
        <form asp-controller="Booking" asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input asp-for="SessionId" type="hidden" />
            <div class="mb-4">
                <label asp-for="MemberId" class="form-label fw-bold">Aluno</label>
                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select form-select-lg" required>
                    <option value="">Selecione um aluno</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger small"></span>
                <p class="small text-muted mt-2">Uma reserva por aluno e por aula. O sistema também verifica as vagas disponíveis.</p>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2">
                <button class="btn flex-fill text-white fw-bold py-3" style="background:#070093;border-radius:12px" type="submit">
                    Confirmar reserva
                </button>
                <a asp-action="GetMembersForUpcomingSession" asp-route-id="@Model.SessionId"
                   class="btn btn-outline-secondary flex-fill py-3 rounded-3">Cancelar</a>
            </div>
        </form>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}