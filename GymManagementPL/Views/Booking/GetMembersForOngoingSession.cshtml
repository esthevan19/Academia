@model IEnumerable<MemberForSessionViewModel>
@{
    ViewData["Title"] = "Presenças da aula";
    var presentes = Model?.Count(m => m.IsAttended) ?? 0;
    var total = Model?.Count() ?? 0;
}
<style>
    .presenca-card { border:1px solid #e6e5f2; border-radius:18px; background:#fff; overflow:hidden; box-shadow:0 12px 38px rgba(7,0,147,.06); }
    .presenca-card .table th { background:#f1f0ff; color:#070093; font-weight:800; padding:16px; }
    .presenca-card .table td { vertical-align:middle; padding:16px; }
    .presenca-bar { background:#eeeef6; height:9px; border-radius:100px; overflow:hidden; }
    .presenca-progress { height:100%; background:#070093; border-radius:100px; }
    .presenca-button { background:#070093; color:#fff; border-radius:10px; font-weight:700; }
    .presenca-button:hover { background:#241cbd; color:#fff; }
</style>
<section class="container py-4 py-md-5" style="max-width:1060px">
    <header class="mb-4">
        <p class="fw-bold small text-uppercase mb-1" style="color:#070093">GymFlow · Aulas em andamento</p>
        <h1 class="h2 fw-bold mb-2">Registrar presenças</h1>
        <p class="text-muted">Marque a presença de cada aluno inscrito enquanto a aula estiver acontecendo.</p>
    </header>
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-3" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger rounded-3" role="alert">@error</div>
    }
    <div class="presenca-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <strong>Presenças confirmadas</strong>
            <span class="fw-bold" style="color:#070093">@presentes de @total</span>
        </div>
        <div class="presenca-bar" role="progressbar" aria-valuenow="@presentes" aria-valuemin="0"
             aria-valuemax="@total" aria-label="Alunos presentes">
            <div class="presenca-progress" style="width:@(total == 0 ? 0 : presentes * 100 / total)%"></div>
        </div>
    </div>
    <div class="presenca-card mb-4">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Aluno</th><th class="text-end">Presença</th></tr></thead>
                    <tbody>
                    @foreach (var aluno in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@aluno.MemberName</td>
                            <td class="text-end">
                                @if (aluno.IsAttended)
                                {
                                    <span class="badge bg-success-subtle text-success p-2">
                                        <i class="bi bi-check-circle me-1"></i>Presente
                                    </span>
                                }
                                else
                                {
                                    <form asp-controller="Booking" asp-action="Attended" method="post" class="d-inline">
                                        <input type="hidden" name="MemberId" value="@aluno.MemberId" />
                                        <input type="hidden" name="SessionId" value="@aluno.SessionId" />
                                        <button type="submit" class="btn presenca-button btn-sm py-2 px-3">
                                            <i class="bi bi-check2 me-1"></i>Confirmar presença
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center p-5">
                <i class="bi bi-people display-5" style="color:#7875c3"></i>
                <h2 class="h5 fw-bold mt-3">Nenhum aluno inscrito</h2>
                <p class="text-muted mb-0">Quando houver reservas, os alunos aparecerão nesta lista.</p>
            </div>
        }
    </div>
    <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-secondary rounded-3">
        <i class="bi bi-arrow-left me-1"></i> Voltar à agenda
    </a>
</section>