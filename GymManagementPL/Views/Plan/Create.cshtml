@model GymManagementBLL.ViewModels.PlanViewModels.CreatePlanViewModel
@{
    ViewData["Title"] = "Cadastrar plano";
}
<section class="container py-4" style="max-width:850px">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="small fw-bold" style="color:#070093">GYMFLOW · PLANOS</span>
            <h1 class="h2 fw-bold mt-2" style="color:#070093">Cadastrar novo plano</h1>
            <p class="text-muted mb-0">Configure os valores e a duração em reais, com campos simples.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar aos planos</a>
    </div>
    <form asp-controller="Plan" asp-action="Create" method="post" class="card p-4 rounded-4 shadow-sm border-0">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="PlanName" class="form-label fw-semibold">Nome do plano</label>
            <input asp-for="PlanName" class="form-control" maxlength="100" placeholder="Ex.: Musculação mensal" />
            <span asp-validation-for="PlanName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold">Descrição e benefícios</label>
            <textarea asp-for="Description" class="form-control" rows="3" maxlength="200" placeholder="Descreva os benefícios do plano"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="DurationDays" class="form-label fw-semibold">Duração em dias</label>
                <input asp-for="DurationDays" class="form-control" type="number" min="1" max="365" />
                <span asp-validation-for="DurationDays" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-semibold">Preço (R$)</label>
                <input asp-for="Price" class="form-control" type="text" inputmode="decimal" placeholder="99,90" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary py-3" style="background:#070093;border-color:#070093">
            Salvar plano
        </button>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
