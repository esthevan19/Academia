@model CreateAdminViewModel
<div class="container mt-5">
    <!-- Cabeçalho -->
    <div class="text-center mb-4">
        <h1 class="fw-bold" style="letter-spacing:1px; color:#070093;">Adicionar Novo Administrador</h1>
        <p class="text-muted">Preencha as informações abaixo para criar uma nova conta de admin</p>
        <hr class="w-50 mx-auto" style="border-top:3px solid #070093;" />
    </div>
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Erros:</strong>
            <ul class="mb-0">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <form asp-action="Create" method="post" class="mt-3">
        <!-- Nome de Usuário -->
        <div class="mb-3">
            <label asp-for="UserName" class="form-label fw-semibold"></label>
            <input asp-for="UserName" class="form-control shadow-sm" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <!-- Nome e Sobrenome -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                <input asp-for="FirstName" class="form-control shadow-sm" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label fw-semibold"></label>
                <input asp-for="LastName" class="form-control shadow-sm" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <!-- Telefone -->
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
            <input asp-for="PhoneNumber" class="form-control shadow-sm" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <!-- Email -->
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <input asp-for="Email" class="form-control shadow-sm" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <!-- Perfil / Função -->
        <div class="mb-3">
            <label asp-for="Role" class="form-label fw-semibold">Perfil / Função</label>
            <select asp-for="Role" class="form-select shadow-sm" required>
                <option value="Admin">Administrador (Gestão Geral)</option>
                <option value="Gerente">Gerente (Operacional e Relatórios)</option>
                <option value="Recepcionista">Recepcionista (Atendimento e Matrículas)</option>
                <option value="Instrutor">Instrutor (Montagem de Treinos)</option>
                <option value="Aluno">Aluno (Acesso ao App e Treinos)</option>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <option value="SuperAdmin">SuperAdmin (Dono / Acesso Máximo)</option>
                }
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <!-- Senha + Confirmar Senha -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <input asp-for="Password" type="password" class="form-control shadow-sm" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control shadow-sm" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <!-- Botão de Envio -->
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm" style="background:#070093; border-color:#070093;">
                Cadastrar Usuário
            </button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
