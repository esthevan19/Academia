@model IEnumerable<AdminListViewModel>
@{
    ViewData["Title"] = "Gerenciar usuários";
}
<div class="container mt-4">
    @* Alertas do TempData *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="Alert" class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="Alert" class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    <header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-3 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1 fw-semibold">Gerenciar usuários</h2>
                <p class="mb-0 text-light opacity-75">Contas e permissões de acesso do GymFlow</p>
            </div>
            <div class="text-end">
                <a asp-action="Create" class="btn btn-light">
                    <i class="fas fa-plus me-1"></i> Cadastrar usuário
                </a>
            </div>
        </div>
    </header>
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-striped table-hover align-middle text-center">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Nome de Usuário</th>
                            <th>Perfil / Função</th>
                            <th class="text-center">Vínculo com aluno</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model)
                        {
                            <tr>
                                <td>@admin.Email</td>
                                <td>@admin.UserName</td>
                                <td>
                                    @if (admin.Role == "SuperAdmin")
                                    {
                                        <span class="badge bg-danger px-3 py-2 fs-6">SuperAdmin</span>
                                    }
                                    else if (admin.Role == "Admin")
                                    {
                                        <span class="badge bg-primary px-3 py-2 fs-6" style="background-color:#070093 !important;">Administrador</span>
                                    }
                                    else if (admin.Role == "Gerente")
                                    {
                                        <span class="badge bg-success px-3 py-2 fs-6">Gerente</span>
                                    }
                                    else if (admin.Role == "Recepcionista")
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 fs-6">Recepcionista</span>
                                    }
                                    else if (admin.Role == "Instrutor")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 fs-6">Instrutor</span>
                                    }
                                    else if (admin.Role == "Aluno")
                                    {
                                        <span class="badge bg-secondary px-3 py-2 fs-6">Aluno</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark px-3 py-2 fs-6">@admin.Role</span>
                                    }
                                </td>
                                <td class="text-start">
                                    @if (admin.Role == "Aluno")
                                    {
                                        <div class="small mb-2">
                                            @(admin.LinkedMemberId.HasValue ? "Aluno vinculado (ID " + admin.LinkedMemberId + ")" : "Conta sem vínculo")
                                        </div>
                                        @if (User.IsInRole("SuperAdmin"))
                                        {
                                            <form asp-action="LinkMember" method="post" class="d-flex flex-wrap gap-1 mb-2">
                                                <input type="hidden" name="userId" value="@admin.Id" />
                                                <select class="form-select form-select-sm" name="memberId" required aria-label="Selecionar aluno" style="min-width:150px;max-width:260px">
                                                    <option value="">Selecione o cadastro do aluno</option>
                                                    @foreach (var aluno in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.MemberOptions)
                                                    {
                                                        <option value="@aluno.Value" selected="@(admin.LinkedMemberId?.ToString() == aluno.Value)">@aluno.Text</option>
                                                    }
                                                </select>
                                                <button class="btn btn-sm btn-primary" type="submit">Vincular</button>
                                            </form>
                                            @if (admin.LinkedMemberId.HasValue)
                                            {
                                                <form asp-action="UnlinkMember" method="post" onsubmit="return confirm('Remover o vínculo desta conta com o aluno?');">
                                                    <input type="hidden" name="userId" value="@admin.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desvincular</button>
                                                </form>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Não se aplica</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (User.IsInRole("SuperAdmin") || admin.Role != "SuperAdmin")
                                    {
                                        <a asp-action="Edit" asp-route-id="@admin.Id" class="btn btn-warning btn-sm">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@admin.Id" class="btn btn-danger btn-sm">Excluir</a>
                                    }
                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <a asp-action="ResetPassword" asp-route-id="@admin.Id" class="btn btn-info btn-sm text-white">Redefinir senha</a>
                                        <a asp-action="ManageRoles" asp-route-id="@admin.Id" class="btn btn-secondary btn-sm">Perfis</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-workspace display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Nenhum usuário cadastrado</h4>
                    <p class="text-muted">Cadastre o primeiro usuário para começar</p>
                </div>
            }
        </div>
        @if (User.IsInRole("SuperAdmin"))
        {
            <p class="small text-muted px-3 pb-3">Após vincular uma conta ao cadastro do aluno, peça que ele saia e entre novamente no site e no aplicativo para atualizar as permissões.</p>
        }
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const alertBox = document.getElementById("Alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";
                    setTimeout(() => alertBox.remove(), 500);
                }, 1500);
            }
        });
    </script>
}
