@{
    ViewData["Title"] = "Excluir Admin";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <!-- Card -->
            <div class="card p-5 shadow" style="border-radius:15px;">
                <!-- Cabeçalho -->
                <h2 class="text-center fw-bold mb-4" style="color:#070093; letter-spacing:1px;">
                    Excluir Admin
                </h2>
                <p class="fs-5 text-center mb-4">Tem certeza que deseja excluir este Admin?</p>
                <!-- Alerta de Aviso -->
                <div class="alert alert-warning text-start" role="alert">
                    <strong>Atenção!</strong> Esta ação não pode ser desfeita. Todos os dados do Admin serão excluídos permanentemente.
                </div>
                <!-- Formulário -->
                <form method="post" asp-action="DeleteConfirmed" class="mt-4">
                    <input type="hidden" readonly name="id" value="@ViewBag.AdminId" />
                    <div class="d-flex gap-3">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary flex-fill fw-semibold">
                            NÃO
                        </a>
                        <button type="submit"
                                class="btn flex-fill fw-semibold text-white"
                                style="background:#070093; border-color:#070093;">
                            SIM
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
