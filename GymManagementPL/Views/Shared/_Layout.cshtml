@{
    var CurrentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Bootstrap 5.3.8 css file -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ^ Our main css file -->
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/gymflow-theme.css" asp-append-version="true" />
    <title>GymFlow | @ViewData["Title"] </title>
</head>

<body>
    <header>
        <!-- ^ navbar -->
        <nav class="navbar navbar-expand-lg bg-white shadow-sm py-3">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-activity me-2"></i>GymFlow</a>

                <!-- Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Links -->
                <div class="collapse navbar-collapse" id="navbarSupportedContent">

                    <ul class="navbar-nav d-flex align-items-center m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Início</a>
                        </li>

                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente") || User.IsInRole("Recepcionista"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Member" ? "active" : "")"
                                   asp-controller="Member" asp-action="Index">Alunos</a>
                            </li>
                        }

                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente") || User.IsInRole("Instrutor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Trainer" ? "active" : "")"
                                   asp-controller="Trainer" asp-action="Index">Treinadores</a>
                            </li>
                        }

                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente") || User.IsInRole("Instrutor"))
                        {
                            <li class="nav-item"><a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "WorkoutManagement" ? "active" : "")" asp-controller="WorkoutManagement" asp-action="Index">Treinos</a></li>
                        }

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Session" ? "active" : "")"
                               asp-controller="Session" asp-action="Index">Aulas Coletivas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Plan" ? "active" : "")"
                               asp-controller="Plan" asp-action="Index">Planos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Membership" ? "active" : "")"
                               asp-controller="Membership" asp-action="Index">Matrículas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "Booking" ? "active" : "")"
                               asp-controller="Booking" asp-action="Index">Agenda</a>
                        </li>

                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 fw-semibold fs-5 @(CurrentController == "AdminManagement" ? "active" : "")"
                                   asp-controller="AdminManagement" asp-action="Index">Gerenciar Usuários</a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-lg-3 d-flex align-items-center">
                                <span class="badge bg-light text-dark border me-2 py-2 px-3 fw-normal">
                                    <i class="bi bi-person-circle me-1 text-primary"></i> @User.Identity?.Name
                                </span>
                                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline m-0">
                                    <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-1 fw-semibold" title="Sair do Sistema">
                                        <i class="bi bi-box-arrow-right me-1"></i> Sair
                                    </button>
                                </form>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
