@{
    ViewData["Title"] = "Minha conta";
}
<section class="container py-5" style="max-width: 850px">
    <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border">
        <p class="fw-bold mb-2" style="color:#070093">GYMFLOW · ÁREA DO ALUNO</p>
        <h1 class="h2 fw-bold">Bem-vindo ao GymFlow!</h1>
        <p class="text-muted">Sua conta de acesso está pronta.</p>
        <div class="d-flex flex-wrap gap-2 mt-4 mb-3">
            <a class="btn text-white" style="background:#070093" asp-controller="Student" asp-action="Index">Ver meus treinos</a>
            <a class="btn btn-outline-primary" asp-controller="Session" asp-action="Index">Ver aulas coletivas</a>
            <a class="btn btn-outline-secondary" asp-controller="Plan" asp-action="Index">Consultar planos</a>
        </div>
        @if (User.HasClaim(claim => claim.Type == "gymflow:member_id"))
        {
            <div class="alert alert-success mt-4" role="status">
                Sua conta está vinculada ao cadastro de aluno.
                Você pode consultar suas fichas em <strong>Meus treinos</strong>.
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4" role="status">
                Para consultar seus treinos, peça ao SuperAdmin para vincular esta conta
                ao seu cadastro de aluno. Depois, saia e entre novamente.
            </div>
        }
        <p class="mb-1"><strong>E-mail da conta:</strong> @User.Identity?.Name</p>
        <p class="small text-muted mb-0">Cadastros de alunos, mensalidades e gerenciamento da academia ficam disponíveis apenas para a equipe autorizada.</p>
    </div>
</section>