@using GymManagementBLL.ViewModels.AnalyticsViewModels
@model AnalyticsViewModel

@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container">
    <main role="main" class="pb-3">
        <div class="row">
            <div class="col-md-6 col-lg-7 col-12">
                <div class="info mt-4">
                    <header class="text-black-alternative">
                        <h2 class="fw-bolder display-2 mb-4">
                            Seu corpo pode
                            <span class="text-primary-color">suportar quase</span> tudo
                        </h2>

                        <p class="mb-6">
                            É a sua mente que precisa ser convencida. Supere seus
                            limites, <br />
                            mantenha o compromisso e veja seu corpo se transformar em uma
                            <br />
                            potência de força e resiliência. Comece sua jornada hoje e
                            descubra o que você é capaz de fazer!
                        </p>
                    </header>

                    <div class="stats-bar">
                        <div class="row g-0">
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder fs-5 d-block mb-1">@Model.TotalMembers</span>
                                    <h3 class="fs-5 fw-normal">Total de Membros</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder fs-5 d-block mb-1">@Model.ActiveMembers</span>
                                    <h3 class="fs-5 fw-normal">Membros Ativos</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder fs-5 d-block mb-1">@Model.TotalTrainers</span>
                                    <h3 class="fs-5 fw-normal">Treinadores</h3>
                                </div>
                            </div>
                        </div>
                        <div class="row g-0">
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder fs-5 d-block mb-1">@Model.UpcomingSessions</span>
                                    <h3 class="fs-5 fw-normal">Próximas Sessões</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder fs-5 d-block mb-1">@Model.OngoingSessions</span>
                                    <h3 class="fs-5 fw-normal">Sessões em Andamento</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder fs-5 d-block mb-1">@Model.CompletedSessions</span>
                                    <h3 class="fs-5 fw-normal">Sessões Concluídas</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="buttons my-4">
                        <button class="get-started bg-primary-color text-white btn rounded-5 fw-medium px-3 py-2 me-5 border-2 border-primary-color">
                            Comece Agora
                        </button>

                        <button class="explore-more border-primary-color btn rounded-5 fw-medium px-3 py-2 border-2 text-primary-color fw-medium">
                            Explorar Mais
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-1 offset-md-2 col-12 order-first order-md-last">
                <div class="character d-md-block d-flex justify-content-center">
                    <img src="~/images/Theo Vance.jpg" alt="Theo Vance" />
                </div>
            </div>
        </div>

        <div class="bar bg-primary-color d-flex py-4 text-white fw-bolder align-items-center">
            <p class="py-0 my-0 overflow-hidden text-nowrap">
                treinadores externos e online
                <img src="~/images/star.svg" alt="ícone de estrela" /> treinamento personalizado
                <img src="~/images/star.svg" alt="ícone de estrela" /> aulas em tempo real
                <img src="~/images/star.svg" alt="ícone de estrela" /> treinadores pessoais
                <img src="~/images/star.svg" alt="ícone de estrela" /> treinamento personalizado
            </p>
        </div>

        <!-- ^ all other section -->
        <main>
            <!-- ^ about section -->
            <section class="about my-5 text-black-alternative">
                <div class="container">
                    <div class="row g-5 justify-content-center">
                        <div class="col-12 col-lg-6 w-50 w-md-100">
                            <div class="characters position-relative">
                                <div class="image">
                                    <img class="" src="~/images/about p1.jpg" alt="pessoa" />
                                </div>

                                <div class="image position-absolute d-none d-lg-block">
                                    <img src="~/images/about p2.jpg" alt="pessoa" />
                                </div>

                                <div class="image position-absolute d-none d-lg-block">
                                    <img src="~/images/about p3.jpg" alt="pessoa" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="title d-flex justify-content-start align-items-start gap-2">
                                <img class="" src="~/images/dumbbell.jpg" alt="ícone de halter" />
                                <h2 class="text-primary-color fs-5">Sobre Nós</h2>
                            </div>

                            <header>
                                <p class="fw-bolder display-6 mb-4">
                                    CAPACITANDO VOCÊ A ALCANÇAR
                                    <span class="text-primary-color">SEUS OBJETIVOS DE</span> FITNESS
                                </p>
                                <p class="text">
                                    Acreditamos que fitness é mais do que apenas um treino — é
                                    um estilo de vida. Com instalações de ponta, treinadores
                                    certificados e uma comunidade que apoia, estamos aqui para
                                    inspirar e guiar você em cada etapa do caminho.
                                </p>
                            </header>

                            <div class="features">
                                <div class="row row-cols-1 row-cols-sm-2 gx-3 gy-5">
                                    <div class="feature">
                                        <div class="inner">
                                            <div class="title d-flex gap-2">
                                                <img src="~/images/feature icon.jpg" alt="ícone" />
                                                <h3 class="fw-bold">Treinador Pessoal</h3>
                                            </div>
                                            <div class="info">
                                                <p>Alcance seus objetivos de fitness com a</p>
                                                <p>orientação dos nossos treinadores certificados.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="feature">
                                        <div class="inner">
                                            <div class="title d-flex gap-2">
                                                <img src="~/images/feature icon.jpg" alt="ícone" />
                                                <h3 class="fw-bold">Treinador Pessoal</h3>
                                            </div>
                                            <div class="info">
                                                <p>Alcance seus objetivos de fitness com a</p>
                                                <p>orientação dos nossos treinadores certificados.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="feature">
                                        <div class="inner">
                                            <div class="title d-flex gap-2">
                                                <img src="~/images/feature icon.jpg" alt="ícone" />
                                                <h3 class="fw-bold">Treinador Pessoal</h3>
                                            </div>
                                            <div class="info">
                                                <p>Alcance seus objetivos de fitness com a</p>
                                                <p>orientação dos nossos treinadores certificados.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="feature">
                                        <div class="inner">
                                            <div class="title d-flex gap-2">
                                                <img src="~/images/feature icon.jpg" alt="ícone" />
                                                <h3 class="fw-bold">Treinador Pessoal</h3>
                                            </div>
                                            <div class="info">
                                                <p>Alcance seus objetivos de fitness com a</p>
                                                <p>orientação dos nossos treinadores certificados.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn bg-primary-color rounded-pill text-white fw-medium px-4 py-2 mt-3">
                                    Comece Agora
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ^ workout section -->
            <section class="workout">
                <div class="container">
                    <div class="title">
                        <h2>TREINOS</h2>
                        <p class="text-white fw-bolder fs-2 mb-4">
                            Transforme Seu Corpo com Nossos Treinos Dinâmicos
                        </p>
                    </div>

                    <div class="row row-cols-md-3 row-cols-12 gy-4 gx-2 gx-md-4">
                        <div>
                            <div class="card">
                                <img src="~/images/workout 1.jpg" class="card-img-top" alt="..." />

                                <footer class="card-footer bg-white">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder">
                                        treino em grupo
                                    </h5>
                                    <a href="#" class="">Explorar</a>
                                </footer>
                            </div>
                        </div>

                        <div>
                            <div class="card">
                                <img src="~/images/workout 2.jpg" class="card-img-top" alt="..." />

                                <footer class="card-footer bg-white">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder">
                                        treino em grupo
                                    </h5>
                                    <a href="#" class="">Explorar</a>
                                </footer>
                            </div>
                        </div>

                        <div>
                            <div class="card">
                                <img src="~/images/workout 3.jpg" class="card-img-top" alt="..." />

                                <footer class="card-footer bg-white">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder">
                                        treino em grupo
                                    </h5>
                                    <a href="#" class="">Explorar</a>
                                </footer>
                            </div>
                        </div>
                    </div>

                    <div class="indicators">
                        <div class="indicator"></div>
                        <div class="indicator active"></div>
                        <div class="indicator"></div>
                        <div class="indicator"></div>
                    </div>
                </div>
            </section>

            <!-- ^ why-us section -->
            <section class="why-us my-5">
                <div class="container">
                    <div class="row row-cols-1 row-cols-lg-2">
                        <div class="info">
                            <div>
                                <div class="title d-flex justify-content-start align-items-start gap-2">
                                    <img class="" src="~/images/dumbbell.jpg" alt="ícone de halter" />
                                    <h2 class="text-primary-color fs-5">Por Que Nós</h2>
