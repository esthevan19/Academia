@using GymManagementBLL.ViewModels.AnalyticsViewModels
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Painel da Academia";
}
<section class="gf-dashboard py-3">
    <div class="gf-hero mb-4">
        <div>
            <div class="gf-eyebrow"><i class="bi bi-activity me-2"></i>GYMFLOW · PAINEL DE CONTROLE</div>
            <h1 class="fw-bold mt-2 mb-2">Bem-vindo à sua academia</h1>
            <p class="mb-0">Acompanhe os resultados e gerencie sua operação em um só lugar.</p>
        </div>
        <i class="bi bi-bar-chart-line gf-hero-icon" aria-hidden="true"></i>
    </div>
    <h2 class="h5 fw-bold mb-3">Visão geral</h2>
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-4"><div class="gf-stat"><div class="gf-stat-icon"><i class="bi bi-people"></i></div><span>Total de alunos</span><strong>@Model.TotalMembers</strong></div></div>
        <div class="col-6 col-xl-4"><div class="gf-stat"><div class="gf-stat-icon"><i class="bi bi-person-check"></i></div><span>Alunos ativos</span><strong>@Model.ActiveMembers</strong></div></div>
        <div class="col-6 col-xl-4"><div class="gf-stat"><div class="gf-stat-icon"><i class="bi bi-person-badge"></i></div><span>Instrutores</span><strong>@Model.TotalTrainers</strong></div></div>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente") || User.IsInRole("Recepcionista"))
        {
            <div class="col-6 col-xl-4">
                <a asp-controller="Membership" asp-action="Index" class="gf-stat text-decoration-none" aria-label="Ver matrículas próximas do vencimento">
                    <div class="gf-stat-icon"><i class="bi bi-bell"></i></div>
                    <span>Matrículas vencendo em 7 dias</span><strong>@Model.ExpiringInSevenDays</strong>
                    <small style="color:#070093">Ver matrículas →</small>
                </a>
            </div>
        }
        <div class="col-6 col-xl-4"><div class="gf-stat"><div class="gf-stat-icon"><i class="bi bi-calendar-plus"></i></div><span>Próximas aulas</span><strong>@Model.UpcomingSessions</strong></div></div>
        <div class="col-6 col-xl-4"><div class="gf-stat"><div class="gf-stat-icon"><i class="bi bi-clock-history"></i></div><span>Aulas em andamento</span><strong>@Model.OngoingSessions</strong></div></div>
        <div class="col-6 col-xl-4"><div class="gf-stat"><div class="gf-stat-icon"><i class="bi bi-check-circle"></i></div><span>Aulas concluídas</span><strong>@Model.CompletedSessions</strong></div></div>
    </div>
    <h2 class="h5 fw-bold mb-3">Acesso rápido</h2>
    <div class="row g-3">
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente") || User.IsInRole("Recepcionista"))
        {
            <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="Member" asp-action="Index"><i class="bi bi-people"></i><span><strong>Alunos</strong><small>Cadastros e informações</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        }
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente"))
        {
            <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="Trainer" asp-action="Index"><i class="bi bi-person-badge"></i><span><strong>Instrutores</strong><small>Equipe e profissionais</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        }
        <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="Plan" asp-action="Index"><i class="bi bi-card-checklist"></i><span><strong>Planos</strong><small>Planos da academia</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="Session" asp-action="Index"><i class="bi bi-calendar-event"></i><span><strong>Aulas coletivas</strong><small>Atividades e horários</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Gerente") || User.IsInRole("Recepcionista"))
        {
            <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="Membership" asp-action="Index"><i class="bi bi-person-vcard"></i><span><strong>Matrículas</strong><small>Vínculos e inscrições</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        }
        <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="Booking" asp-action="Index"><i class="bi bi-calendar-week"></i><span><strong>Agenda</strong><small>Reservas e presença</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <div class="col-12 col-md-6 col-xl-4"><a class="gf-shortcut" asp-controller="AdminManagement" asp-action="Index"><i class="bi bi-shield-lock"></i><span><strong>Usuários</strong><small>Contas e permissões</small></span><i class="bi bi-chevron-right ms-auto"></i></a></div>
        }
    </div>
</section>
<style>
.gf-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:32px;border-radius:24px;background:linear-gradient(115deg,#070093,#2923bc);color:#fff;overflow:hidden}
.gf-hero h1{color:#fff;font-size:clamp(1.5rem,3vw,2.4rem)}
.gf-hero p{color:#e4e2ff}.gf-eyebrow{font-size:.73rem;letter-spacing:1.5px;font-weight:800;color:#c8c6ff}
.gf-hero-icon{font-size:5rem;color:#9995ff;opacity:.55}
.gf-stat{height:100%;min-height:145px;background:#fff;border:1px solid #e9e9f3;border-radius:19px;padding:20px;display:flex;flex-direction:column;gap:8px}
.gf-stat-icon{display:grid;place-items:center;width:37px;height:37px;border-radius:11px;background:#eae9ff;color:#070093}
.gf-stat span{font-size:.83rem;color:#55556b}.gf-stat strong{font-size:1.8rem;color:#202033;line-height:1.1}
.gf-shortcut{display:flex;align-items:center;gap:13px;padding:19px;border:1px solid #e9e9f3;background:#fff;border-radius:17px;color:#202033;text-decoration:none;height:100%;transition:transform .15s,border-color .15s}
.gf-shortcut:hover{transform:translateY(-2px);border-color:#070093;color:#070093}
.gf-shortcut>i:first-child{font-size:1.4rem;color:#070093;background:#eae9ff;padding:10px;border-radius:12px}
.gf-shortcut span{display:flex;flex-direction:column;gap:3px}.gf-shortcut small{color:#55556b;font-size:.77rem}
@@media(max-width:575px){.gf-hero{padding:23px}.gf-hero-icon{display:none}.gf-stat{min-height:130px;padding:15px}}
</style>
